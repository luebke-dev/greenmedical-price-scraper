# Copy to `.env` (git-ignored). Used by docker compose and – when exported into the shell
# (`set -a; source .env; set +a`) – by `cargo run` and the Quasar dev server.
# All backend variables: docs/api-contract.md.
# Values containing spaces or shell metacharacters MUST be double-quoted so that `source`
# works; docker compose strips the quotes again.

# --- docker compose --------------------------------------------------------
# Host port of the compose PostgreSQL. Change if 5432 is already taken (e.g. by another local DB)
# and adjust DATABASE_URL below accordingly.
POSTGRES_PORT=5432
BACKEND_PORT=8080
METRICS_PORT=9090
FRONTEND_PORT=8081
# Mailpit (dev mail catcher): web UI http://localhost:8025, SMTP 1025.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- backend (cargo run / sqlx) --------------------------------------------
DATABASE_URL=postgres://greenmedical:greenmedical@localhost:5432/greenmedical
DATABASE_MAX_CONNECTIONS=10
HTTP_BIND=0.0.0.0:8080
METRICS_BIND=0.0.0.0:9090
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn
MIGRATE_ON_STARTUP=true

# Scheduler: off for local development; trigger runs manually with the admin token.
SCRAPE_ENABLED=false
SCRAPE_BOOTSTRAP=false
SCRAPE_CRON="0 0 * * * *"
SCRAPE_TIMEZONE=Europe/Berlin
SCRAPE_BOOTSTRAP_MAX_AGE=2h
SCRAPE_STALE_RUN_AFTER=2h
#SCRAPE_BASE_URL=https://greenmedical.health
ANSAY_ENABLED=true
#ANSAY_BASE_URL=https://shop.dransay.com
ANSAY_CONCURRENCY=4
#SCRAPE_PHARMACY_DELAY=300ms
#SCRAPE_PAGE_DELAY=500ms

# Enables POST /api/v1/admin/scrape (Authorization: Bearer <token>). Empty = endpoint disabled (404).
ADMIN_TOKEN=dev-token

# Price alerts (e-mail subscriptions). Base URL for links in mails (/sorte/{id}, /abo/...):
# the Quasar dev server for `pnpm dev`, http://localhost:8081 for the compose frontend.
PUBLIC_URL=http://localhost:9000
# false = subscriptions and delivery are disabled; true = send via SMTP.
# The compose backend always uses EMAIL_ENABLED=true + the Mailpit container (SMTP_HOST=mailpit).
EMAIL_ENABLED=true
# SMTP for `cargo run`: Mailpit on the host (no auth). SMTP_TLS: starttls | tls | none (default 587/starttls).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
#SMTP_USERNAME=
#SMTP_PASSWORD=
EMAIL_FROM="GreenMedical Livebestand <noreply@localhost>"
# Max. subscriptions/confirmation mails per IP (in-memory), format <count>/<duration>.
SUBSCRIPTION_RATE_LIMIT=5/1h

# --- frontend (pnpm dev) ---------------------------------------------------
# Target of the Vite dev-server proxy for /api (`pnpm dev`; default http://localhost:8080).
# Quasar does NOT read this file: the variable only takes effect when exported in the shell
# (`set -a; source ../.env; set +a` or inline `API_PROXY_TARGET=http://localhost:8080 pnpm dev`).
# To work without backend/database use `pnpm dev:mock` (= MOCK_API=1): the dev server then
# answers /api/v1/* from the fixtures in frontend/dev/ and does not proxy at all.
API_PROXY_TARGET=http://localhost:8080
