{
  "name": "greenmedical-frontend",
  "version": "2026.8.0",
  "description": "green.luebke.dev – Preistabelle und Preisentwicklung",
  "productName": "green.luebke.dev",
  "author": "Sebastian Lübke",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:mock": "MOCK_API=1 quasar dev",
    "build": "quasar build",
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore --ignore-path .prettierignore && eslint --fix -c ./eslint.config.js \"./{src,dev,test}/**/*.{ts,js,cjs,mjs,vue}\" ./vitest.config.ts",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore --ignore-path .prettierignore && eslint -c ./eslint.config.js \"./{src,dev,test}/**/*.{ts,js,cjs,mjs,vue}\" ./vitest.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node dev/generate-fixtures.ts",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "echarts": "^6.1.0",
    "pinia": "^4.0.2",
    "quasar": "^2.27.0",
    "vue": "^3.5.22",
    "vue-echarts": "^8.1.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.8.1",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^3.0.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.11.8",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
