# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only the variable BACKEND_URL is substituted (NGINX_ENVSUBST_FILTER=^BACKEND_), e.g.
# http://backend:8080 – without a trailing slash, so /api/v1/... is passed through unchanged.

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    server_tokens off;
    absolute_redirect off;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        text/plain text/css text/csv application/json application/javascript text/javascript
        application/xml image/svg+xml font/woff2;

    include /etc/nginx/snippets/security-headers.conf;

    # Liveness / readiness (no dependencies)
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # Backend API (^~: a prefix match here wins over the regex locations below, so e.g.
    # /api/v1/anything.png is proxied instead of being answered by the icon rule)
    location ^~ /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Hashed build assets: cache forever (^~ keeps the icon regex below from matching here)
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Unhashed icons (favicon.ico, /icons/*.png): cache for a day
    location ~* \.(ico|png)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # SPA entry point: never cache
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # SPA fallback (history mode)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
