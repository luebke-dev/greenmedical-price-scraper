{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "greenmedical values",
  "type": "object",
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "anyMap": {
      "type": "object"
    },
    "labelSelector": {
      "type": "object",
      "properties": {
        "matchLabels": { "$ref": "#/definitions/stringMap" },
        "matchExpressions": { "type": "array" }
      },
      "additionalProperties": false
    },
    "quantityOrEmpty": {
      "type": ["string", "integer"],
      "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?)?$"
    },
    "quantity": {
      "description": "Kubernetes resource quantity; plain numbers (cpu: 1, memory: 134217728) are valid too.",
      "type": ["string", "number"],
      "pattern": "^[0-9]+(\\.[0-9]+)?(e[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "quantityMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/quantity" }
    },
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(ns|us|µs|ms|s|m|h|d|w|y)\\s*)*$"
    },
    "portNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "nodePort": {
      "type": ["integer", "string"],
      "pattern": "^$"
    },
    "pullPolicy": {
      "type": "string",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "serviceType": {
      "type": "string",
      "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      },
      "required": ["repository", "pullPolicy"],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "scheme": { "type": "string", "enum": ["HTTP", "HTTPS"] },
        "httpHeaders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          }
        },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/quantityMap" },
        "limits": { "$ref": "#/definitions/quantityMap" }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "string"], "pattern": "^$", "minimum": 1 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "string"], "pattern": "^$", "minimum": 1 },
        "behavior": { "$ref": "#/definitions/anyMap" }
      },
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxUnavailable": { "type": ["integer", "string"] },
            "maxSurge": { "type": ["integer", "string"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/definitions/serviceType" },
        "port": { "$ref": "#/definitions/portNumber" },
        "metricsPort": { "$ref": "#/definitions/portNumber" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "nodePort": { "$ref": "#/definitions/nodePort" },
        "clusterIP": { "type": "string" }
      },
      "required": ["type", "port"],
      "additionalProperties": false
    },
    "networkPeer": {
      "type": "object",
      "properties": {
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "podSelector": { "$ref": "#/definitions/labelSelector" }
      },
      "additionalProperties": false
    },
    "workloadCommon": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "extraEnv": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podSecurityContext": { "$ref": "#/definitions/anyMap" },
        "securityContext": { "$ref": "#/definitions/anyMap" },
        "resources": { "$ref": "#/definitions/resources" },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "strategy": { "$ref": "#/definitions/strategy" },
        "tmpSizeLimit": { "$ref": "#/definitions/quantityOrEmpty" },
        "extraVolumes": { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "priorityClassName": { "type": "string" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array" },
        "affinity": { "$ref": "#/definitions/anyMap" },
        "topologySpreadConstraints": { "type": "array" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "commonAnnotations": { "$ref": "#/definitions/stringMap" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "automountServiceAccountToken": { "type": "boolean" }
      },
      "required": ["create"],
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "url": { "type": "string", "pattern": "^(postgres(ql)?://.*)?$" }
      },
      "additionalProperties": false
    },
    "adminToken": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "email": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "from": { "type": "string" },
        "smtp": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "$ref": "#/definitions/portNumber" },
            "tls": { "type": "string", "enum": ["starttls", "tls", "none"] },
            "existingSecret": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" }
          },
          "required": ["port", "tls"],
          "additionalProperties": false
        }
      },
      "required": ["enabled", "smtp"],
      "additionalProperties": false
    },
    "backend": {
      "allOf": [
        { "$ref": "#/definitions/workloadCommon" },
        {
          "type": "object",
          "properties": {
            "args": { "type": "array", "items": { "type": "string" } },
            "config": {
              "type": "object",
              "properties": {
                "logFormat": { "type": "string", "enum": ["json", "pretty"] },
                "rustLog": { "type": "string" },
                "migrateOnStartup": { "type": "boolean" },
                "databaseMaxConnections": { "type": "integer", "minimum": 4 },
                "httpRequestTimeout": { "$ref": "#/definitions/duration" },
                "snapshotRevalidateInterval": { "$ref": "#/definitions/duration" },
                "corsAllowedOrigins": { "type": "string" },
                "publicUrl": { "type": "string", "pattern": "^(https?://[^/]+.*)?$" },
                "subscriptionRateLimit": { "type": "string", "pattern": "^([0-9]+/[0-9]+(ms|s|m|h|d))?$" },
                "scrapeEnabled": { "type": "boolean" },
                "scrapeCron": { "type": "string", "minLength": 1 },
                "scrapeTimezone": { "type": "string", "minLength": 1 },
                "scrapeBootstrap": { "type": "boolean" },
                "scrapeBootstrapMaxAge": { "$ref": "#/definitions/duration" },
                "scrapeStaleRunAfter": { "$ref": "#/definitions/duration" },
                "scrapeBaseUrl": { "type": "string", "pattern": "^(https?://.*)?$" },
                "ansayEnabled": { "type": "boolean" },
                "ansayBaseUrl": { "type": "string", "pattern": "^(https?://.*)?$" },
                "ansayConcurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
                "scrapeUserAgent": { "type": "string" },
                "scrapeRequestTimeout": { "$ref": "#/definitions/duration" },
                "scrapeRetryTotal": { "type": ["integer", "string"], "pattern": "^$", "minimum": 0 },
                "scrapeBackoffFactor": { "type": ["number", "string"], "pattern": "^$", "minimum": 0 },
                "scrapePharmacyDelay": { "$ref": "#/definitions/duration" },
                "scrapePageDelay": { "$ref": "#/definitions/duration" },
                "scrapeMinSuccessRatio": { "type": ["number", "string"], "pattern": "^$", "minimum": 0, "maximum": 1 },
                "extra": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
              },
              "required": ["logFormat", "scrapeEnabled", "scrapeCron", "scrapeTimezone"],
              "additionalProperties": false
            },
            "extraEnvFrom": { "type": "array" },
            "service": { "$ref": "#/definitions/service" }
          },
          "required": ["replicaCount", "image", "config", "service", "terminationGracePeriodSeconds"]
        }
      ]
    },
    "frontend": {
      "allOf": [
        { "$ref": "#/definitions/workloadCommon" },
        {
          "type": "object",
          "properties": {
            "service": { "$ref": "#/definitions/service" }
          },
          "required": ["replicaCount", "image", "service"]
        }
      ]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  },
                  "required": ["path"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["host"],
            "additionalProperties": false
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["hosts"],
            "additionalProperties": false
          }
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "interval": { "$ref": "#/definitions/duration" },
            "scrapeTimeout": { "$ref": "#/definitions/duration" },
            "labels": { "$ref": "#/definitions/stringMap" },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "honorLabels": { "type": "boolean" },
            "relabelings": { "type": "array" },
            "metricRelabelings": { "type": "array" }
          },
          "required": ["enabled"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressController": { "$ref": "#/definitions/networkPeer" },
        "monitoring": { "$ref": "#/definitions/networkPeer" },
        "dns": { "$ref": "#/definitions/networkPeer" },
        "externalEgress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "cidr": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]+$" },
            "except": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]+$" } },
            "port": { "$ref": "#/definitions/portNumber" }
          },
          "required": ["enabled", "cidr", "port"],
          "additionalProperties": false
        },
        "smtp": {
          "type": "object",
          "properties": {
            "cidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]+$" } },
            "podSelector": { "$ref": "#/definitions/labelSelector" },
            "namespaceSelector": { "$ref": "#/definitions/labelSelector" }
          },
          "additionalProperties": false
        },
        "dbPort": { "$ref": "#/definitions/portNumber" },
        "extraEgressCIDRs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]+$" } },
        "dbPodSelector": { "$ref": "#/definitions/labelSelector" },
        "dbNamespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "backend": {
          "type": "object",
          "properties": {
            "extraIngress": { "type": "array" },
            "extraEgress": { "type": "array" }
          },
          "additionalProperties": false
        },
        "frontend": {
          "type": "object",
          "properties": {
            "extraIngress": { "type": "array" },
            "extraEgress": { "type": "array" }
          },
          "additionalProperties": false
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
          },
          "required": ["repository", "tag"],
          "additionalProperties": false
        },
        "requireData": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["enabled"],
      "additionalProperties": false
    }
  },
  "required": ["database", "adminToken", "email", "backend", "frontend", "ingress", "metrics", "networkPolicy", "tests"],
  "additionalProperties": false
}
